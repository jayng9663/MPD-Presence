#pragma once
#include <string_view>

/**
 * Central configuration — edit this file to customise all daemon behaviour.
 *
 * This is a TEMPLATE. Copy it to `config.hpp` before building:
 *     cp include/config.hpp.example include/config.hpp
 *
 * `config.hpp` is git-ignored so your personal settings (and MPD password)
 * are never committed.
 */
namespace config {

	/** Discord application ID. **/
	inline constexpr std::string_view DISCORD_APP_ID = "1343479020918014013";

	/** Activity type **/
	inline constexpr int DISCORD_ACTIVITY_TYPE = 2; // 0=Game, 1=Streaming, 2=Listening, 3=Watching

	/** MPD Host **/
	inline constexpr std::string_view MPD_HOST = "localhost";

	/** MPD port **/
	inline constexpr int MPD_PORT = 6650;

	/** MPD Password (leave empty if MPD has no password) **/
	inline constexpr std::string_view MPD_PASSWORD = "";

	/** Local music folder — must end with '/' **/
	inline constexpr std::string_view MUSIC_FOLDER = "/home/user/Music/";

	/** MPD Ignore list (comma-separated paths) **/
	inline constexpr std::string_view MPD_IGNORE = "";

	/** AcoustID client API key for fingerprint lookups.
	 *  Get your own at https://acoustid.org/login **/
	inline constexpr std::string_view ACOUSTID_API_KEY = "2jFwlOUpO2";

	/** Album art method order (comma-separated), tried until one finds art:
	 *    tag         - MusicBrainz release/release-group ID from the file's tags
	 *                  (e.g. tagged with Picard); no lookup needed
	 *    fingerprint - AcoustID lookup of the audio fingerprint
	 *    search      - MusicBrainz text search on artist + album + date **/
	inline constexpr std::string_view ALBUM_ART_METHOD_ORDER = "tag,fingerprint";
	// inline constexpr std::string_view ALBUM_ART_METHOD_ORDER = "tag,fingerprint,search";

	/** Small icon shown on the album art while playing / paused.
	 *  Either an asset key uploaded to your Discord application, or an image URL.
	 *  Leave empty for no icon. **/
	inline constexpr std::string_view SMALL_IMAGE_PLAYING = "";
	inline constexpr std::string_view SMALL_IMAGE_PAUSED  = "";

	/** Button 1 **/
	inline constexpr std::string_view BUTTON1LABEL = "";
	inline constexpr std::string_view BUTTON1URL   = "";

	/** Button 2 (empty = disabled) **/
	inline constexpr std::string_view BUTTON2LABEL = "";
	inline constexpr std::string_view BUTTON2URL   = "";

} // namespace config
